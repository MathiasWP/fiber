{
	"name": "fiber",
	"private": true,
	"version": "0.10.1",
	"type": "module",
	"packageManager": "pnpm@10.6.5",
	"engines": {
		"node": "^24 || >=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"app": "tauri dev --no-watch",
		"app:build": "tauri build",
		"test": "cargo test --manifest-path src-tauri/Cargo.toml",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-version.mjs",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@iconify-json/lucide": "^1.2.124",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.2.0",
		"@unocss/extractor-svelte": "^66.7.5",
		"@unocss/postcss": "^66.7.5",
		"@unocss/preset-icons": "^66.7.5",
		"@unocss/preset-wind4": "^66.7.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"unocss": "^66.7.5",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.1",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.9",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-opener": "2.5.4",
		"@tauri-apps/plugin-process": "2.3.1",
		"@tauri-apps/plugin-updater": "2.10.1",
		"bits-ui": "^2.18.1",
		"codemirror": "^6.0.2",
		"paneforge": "^1.0.2"
	}
}
